//program that classifies a person's body weight
#include <stdio.h>
int main() 
{
    float weight, height, bmi;
    printf("Enter the weight in kg");
    scanf("%f", &weight);
    printf("enter the height in meters");
    scanf("%f",&height);
    bmi = weight / (height * height);
    printf("\nBMI is %.2f", bmi);
    if (bmi < 18.5)
        printf("Underweight");
    else if (bmi < 25)
        printf("Normal");
    else if (bmi < 30)
        printf("Overweight");
    else
        printf("Obese");
}        
