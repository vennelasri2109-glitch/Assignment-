// program that decides whether a loan can be approved
#include<stdio.h>
void main()
{
    int age,credit;
    float income;
    printf("enter the age,income,credit values");
    scanf("%d%f%d" ,&age,&income,&credit);
    if (21 < age < 60)
        printf("loan rejected:age is not between 21 to 60");
    else if(income < 25000)
        printf("loan rejected:income below 25000" );
    else if(credit<700)
        printf(" loan rejected:credit score below 700");
    else
        printf(" loan approved");
}        

