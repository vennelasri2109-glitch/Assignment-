/*program to determine whether a given number is positive, negative, or
zero using if-else statement*/
#include<stdio.h>
void main()
{
    int a;
    printf("enter a number");
    scanf("%d", &a);
    if(a>0)
        printf("%d is positive number",a);
    else if(a<0)
        printf("%d is negative number",a);
    else
        printf("%d is zero",a);
}            
            
